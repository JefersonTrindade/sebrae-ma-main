table idh_2010
	lineageTag: a6600dee-252a-45e0-a4f5-0b0cba2a5d98

	measure Resumo_IDH = ```
			
			"Em 2010, o IDH era " & 
			FORMAT(SELECTEDVALUE(idh_2010[idh]), "#,##0.00") & 
			". Na comparação com outros municípios do estado, ficava na posição " & 
			SELECTEDVALUE(idh_2010[posicao_estadual_idh]) & " de 217 e na posição " & 
			SELECTEDVALUE(idh_2010[posicao_nacional_idh]) & " de 5.570 entre todos os municípios."
			
			```
		lineageTag: 633804ca-2aeb-402c-878b-e64bcf1d12c8

	measure 'IDH concatenado - Estado' =
			
			SELECTEDVALUE(idh_2010[posicao_estadual_idh]) & " de 217"
		lineageTag: 2fe5ff08-b065-4cb8-951d-9dd25aa7c707

	measure 'IDH concatenado - País' =
			
			SELECTEDVALUE(idh_2010[posicao_nacional_idh]) & " de 5570"
		lineageTag: 83728f76-24b3-4b6a-bc1c-2935e2f39931

