table rais_2023
	lineageTag: 6bf06640-41fd-4f16-9f94-a7ad0e8a9ad5

	measure 'Resumo_Emregos formais' = ```
			
			"Em 2023, o salários médio mensal dos trabalhadores formais no município" & [Nome_municipio] &
			
			"é de " & 
			SELECTEDVALUE(rais_2023[v_salario_medio_sm]) & "e foi registrado " & SELECTEDVALUE(rais_2023[empregos_formais]) & "empregos formais" & "com uma remuneração equivalente a " & SELECTEDVALUE(rais_2023[remuneracao])& "e " & "ocupando a posição " & SELECTEDVALUE(rais_2023[rais_ranking_na_salario_medio_sm]) & "no ranking Nacional."
			```
