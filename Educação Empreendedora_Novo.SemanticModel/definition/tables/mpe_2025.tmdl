	partition mpe_2025 = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.11.4.21", "dw_uim", [Query="SELECT #(lf)#(tab)base.code_muni,#(lf)#(tab)[mpe],#(lf)    [perc_mpe_estado],#(lf)    base.perc_agropecuaria_mpe,#(lf)    base.perc_industria_mpe,#(lf)    base.perc_construcao_mpe,#(lf)    base.perc_comercio_mpe,#(lf)    base.perc_servicos_mpe,#(lf)    MAX(CASE WHEN rn = 1 THEN setor_legivel END) AS Top_1,#(lf)    MAX(CASE WHEN rn = 2 THEN setor_legivel END) AS Top_2,#(lf)    MAX(CASE WHEN rn = 3 THEN setor_legivel END) AS Top_3,#(lf)    MAX(CASE WHEN rn = 4 THEN setor_legivel END) AS Top_4,#(lf)    MAX(CASE WHEN rn = 5 THEN setor_legivel END) AS Top_5#(lf)FROM #(lf)    [dw_uim].[dbo].[mpe_2025] AS base#(lf)CROSS APPLY (#(lf)    SELECT #(lf)        setor_legivel,#(lf)        valor,#(lf)        ROW_NUMBER() OVER (ORDER BY valor DESC) AS rn#(lf)    FROM #(lf)        (VALUES #(lf)            ('Agropecuária', base.perc_agropecuaria_mpe),#(lf)            ('Indústria', base.perc_industria_mpe),#(lf)            ('Construção', base.perc_construcao_mpe),#(lf)            ('Comércio', base.perc_comercio_mpe),#(lf)            ('Serviços', base.perc_servicos_mpe)#(lf)        ) AS setores(setor_legivel, valor)#(lf)) AS ordenado#(lf)GROUP BY #(lf)#(tab)base.code_muni,#(lf)    base.mpe,#(lf)    base.perc_mpe_estado,#(lf)    base.perc_agropecuaria_mpe,#(lf)    base.perc_industria_mpe,#(lf)    base.perc_construcao_mpe,#(lf)    base.perc_comercio_mpe,#(lf)    base.perc_servicos_mpe;#(lf)"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

