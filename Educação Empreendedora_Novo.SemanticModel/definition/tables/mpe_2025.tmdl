table mpe_2025
	lineageTag: c5a17f1b-415e-4f7a-829b-9a3904a8759f

	measure Resumo_MPEs = ```
			
			"Em 2025, o município de " &  
			SELECTEDVALUE(municipio[municipio]) & 
			" conta com um total de " & 
			FORMAT(SELECTEDVALUE(mpe_2025[mpe]), "#,###") & 
			" MPEs. O setor líder é: " & 
			SELECTEDVALUE(mpe_2025[Top_1]) & 
			". Veja a seguir o ranking completo."
			
			```
		lineageTag: 659a355e-67e9-4bea-8fc4-12711ea820b3

